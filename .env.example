# ---------------------------------------------------------------------------
# WhistleDrop AI — example environment file
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env        (Git Bash)
#     copy .env.example .env      (cmd / PowerShell)
#
# `.env` is gitignored and must NEVER be committed.
# This file grows as each phase adds configuration.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="WhistleDrop AI"

# development | test | production
APP_ENV=development

# Verbose error output. Keep false in production.
DEBUG=true

# Serve Swagger UI at /docs and ReDoc at /redoc.
# Kept on by default because the GDG task requires the API to be demonstrable
# via Swagger. A hardened real-world deployment would restrict this.
ENABLE_DOCS=true

LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# These three are consumed by docker-compose.yml to provision the containers.
# POSTGRES_PASSWORD has no default and must be set.
POSTGRES_USER=whistledrop
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=whistledrop
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# DSN used by the application. Must match the values above.
DATABASE_URL=postgresql+psycopg://whistledrop:change-me-to-a-strong-password@localhost:5432/whistledrop

# DSN used by the integration test suite (separate container, separate port,
# so running tests can never touch development data). The test suite refuses to
# run unless this database's name ends in "_test".
TEST_DATABASE_URL=postgresql+psycopg://whistledrop:change-me-to-a-strong-password@localhost:5433/whistledrop_test

# Connection pool sizing. Optional; these are the defaults.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Case codes ------------------------------------------------------------
# Server-side HMAC-SHA256 key used to hash reporter case codes before they are
# stored. The plaintext case code is NEVER written to the database, so this key
# is what makes a stolen database dump useless on its own.
#
# REQUIRED. The application refuses to start without it, refuses the
# placeholder below, and refuses anything shorter than 32 characters.
#
# Generate your own:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Rotating this value permanently invalidates every case code already issued;
# there is no way to re-derive the old digests. Treat it as long-lived.
CASE_CODE_PEPPER=replace-me-with-64-hex-characters-from-the-command-below

# --- Moderator authentication ----------------------------------------------
# Signing key for moderator access tokens. REQUIRED: the application refuses to
# start without it, refuses the placeholder below, and refuses anything shorter
# than 32 characters.
#
# Generate your own (a DIFFERENT value from CASE_CODE_PEPPER):
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Rotating this immediately invalidates every access token in circulation,
# which is the intended response to a suspected leak.
JWT_SECRET_KEY=replace-me-with-a-different-64-hex-value

# Signing algorithm. HMAC family only (HS256 / HS384 / HS512); one service both
# signs and verifies, so there is no public key to distribute.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes. There is no refresh token: when a token
# expires the moderator logs in again.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# bcrypt work factor for moderator passwords. 12 is roughly a quarter-second
# per hash. Must be at least 12 in production; the test suite lowers it.
# PASSWORD_HASH_ROUNDS=12

# --- Hardening -------------------------------------------------------------
# Rate limiting. On by default. Limits use the `limits` notation; several may
# be combined with ';'. These are abuse control, not anonymity.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REPORTS=5/minute;30/hour
# RATE_LIMIT_CASE_LOOKUP=10/minute;60/hour
# RATE_LIMIT_LOGIN=5/minute;20/hour

# Believe X-Forwarded-For when identifying a caller. Leave false unless this
# service sits behind a proxy that OVERWRITES the header — a client can
# otherwise set it freely and mint unlimited rate-limit identities.
# TRUST_PROXY_HEADERS=false

# Largest accepted request body, in bytes. 64 KiB fits the longest allowed
# report with room to spare.
# MAX_REQUEST_BODY_BYTES=65536

# Browser origins allowed to call this API, comma-separated. Empty by default:
# there is no browser front end, so nothing needs cross-origin access.
# CORS is a browser policy, not authentication — it does nothing for curl.
# CORS_ALLOWED_ORIGINS=https://console.example.org
# CORS_ALLOW_CREDENTIALS=false

# HSTS max-age in seconds. 0 disables the header, which is correct without
# TLS: browsers ignore HSTS over plain HTTP, so sending it in development
# would imply a protection that does not exist. Set it (e.g. 31536000) only
# where TLS is actually terminated.
# HSTS_MAX_AGE_SECONDS=0

# --- AI-assisted triage ----------------------------------------------------
# Run the advisory triage model after a report is filed. Off files reports
# exactly as before and writes no triage row; nothing about reporting depends
# on it either way.
# ML_TRIAGE_ENABLED=true

# The model version the server loads. Pinned, never "latest", and never
# selectable by a request.
# ML_MODEL_VERSION=whistledrop-category-v1

# Where artifacts live. An operator setting, never a request parameter.
# ML_ARTIFACT_ROOT=ml/artifacts

# Load the model at startup rather than on the first report, so no reporter
# pays the ~3s scikit-learn import. A failure here is logged and ignored: the
# application still starts, and triage records FAILED.
# ML_WARM_START=true

# ---------------------------------------------------------------------------
# Added in later phases — listed here only so you know what is coming.
# Do not set these yet; nothing reads them.
#
# Phase 7:  ML_MODEL_DIR          path to trained triage artifacts
# ---------------------------------------------------------------------------
