# Normalise line endings so the repository is consistent across Windows,
# macOS and Linux (and inside Docker images).
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.joblib binary
*.pkl binary

# The training dataset is fingerprinted by SHA-256 (see ml/src/data.py), so its
# bytes must be identical on every checkout. Pinned explicitly so a change to
# the global rule above can never silently alter the recorded dataset hash.
ml/data/synthetic_reports.csv text eol=lf
